# Manager dashboard port — to change it, edit this value in your .env copy and run: docker compose up -d
MANAGER_PORT=9000

# Host folder that holds your projects. It does two jobs at once:
# it is mounted into the manager container at the SAME absolute path
# (so the manager can see and manage the projects inside it), and
# the folder picker for Add Project → "from a local folder" opens
# right at this folder. Uncomment, set your own path, then run:
# docker compose up -d   (a restart alone does NOT apply new mounts)
# HOST_PROJECTS_DIR=/Users/you/Files/Project

# Optional: an LLM for the Add Project port scan's AI check. The
# deterministic scan (compose ports, Dockerfile EXPOSE, PORT keys
# in the project's .env) always runs; when these are set, an
# OpenAI-compatible chat completions endpoint also reviews the
# project and can add ports the rules missed (e.g. hard-coded in
# code). The key stays server-side — it is never shown in the UI
# or written to any log. Leave unset to disable the AI check.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
